# Pinned to Node 24 (current LTS as of Sept 2026) on Debian bookworm, by tag
# *and* digest — the tag alone can be repointed upstream at any time, the
# digest can't. To move to a newer Node/base image later, update both
# together (`docker pull node:24-bookworm-slim` and copy the new digest it
# reports).
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# Pin the OS package set to a specific Debian snapshot instead of "whatever
# bookworm has today" — otherwise the exact openssh-server/git/sudo/curl/
# vim/nano versions (and their transitive deps) silently drift across
# rebuilds, weeks or months apart, with no record of what changed.
# Bump DEBIAN_SNAPSHOT deliberately (e.g. to pick up a CVE fix) rather than
# letting it float. If a build ever fails with a 404 from snapshot.debian.org,
# pick a nearby valid timestamp from https://snapshot.debian.org/archive/debian/
# and update this value.
ARG DEBIAN_SNAPSHOT=20260901T000000Z
RUN printf '%s\n%s\n' \
    "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
    "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main" \
    > /etc/apt/sources.list

# Install SSH server, Git, and system dependencies
RUN apt-get update && apt-get install -y \
    openssh-server \
    git \
    sudo \
    curl \
    vim \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Configure the SSH daemon runtime directory
RUN mkdir /var/run/sshd

# Create a standard, non-root lab user
RUN useradd -rm -d /home/labuser -s /bin/bash -g root -G sudo -u 1001 labuser

# Copy custom .bashrc
COPY custom_bashrc.tmpl /home/labuser/.bashrc

# zscaler issue
# Claude Code CLI version is pinned explicitly — bump deliberately when you
# want the newer release, rather than picking up whatever "latest" resolves
# to on rebuild day.
ARG CLAUDE_CODE_VERSION=2.1.278
RUN npm config set strict-ssl false \
    && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && npm config set strict-ssl true

# Set up the workspace mounting target
WORKDIR /workspace
RUN chown -R labuser:root /workspace

# FIX: Pre-create the configuration paths and hand ownership to labuser
RUN mkdir -p /home/labuser/.claude/plugins && chown -R labuser:root /home/labuser/.claude
EXPOSE 22

# entrypoint.sh writes SSH_PASSWORD and the ANTHROPIC_* values into the
# container at *start* time (from the runtime environment docker-compose
# already injects) instead of baking them into this image at *build* time.
# SSH sessions don't inherit the container's process environment, so a login
# shell still needs them persisted somewhere (/etc/environment) — this just
# does it without ever writing a secret into an image layer, and lets a
# rotated password/key take effect on container restart instead of rebuild.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Start the SSH daemon on container initialization
CMD ["/usr/local/bin/entrypoint.sh"]
